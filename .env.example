# Dynamic Labs Configuration (Optional)
# DYNAMIC_ENVIRONMENT_ID=your_environment_id
# DYNAMIC_API_KEY=your_dynamic_api_key

# ============ BACKEND ROUTING ENGINE CONFIGURATION ============

# Backend Server
BACKEND_PORT=3000
BACKEND_HOST=localhost
BACKEND_NODE_ENV=development

# Database (Backend uses Supabase)
BACKEND_DATABASE_URL=postgresql://postgres:[PASSWORD]@db.supabase.co:5432/postgres

# Provider API Keys (Quote Engine)
LIFI_API_KEY=your_lifi_api_key_here
ENABLE_LIFI=true

SOCKET_API_KEY=your_socket_api_key_here
ENABLE_SOCKET=true

RELAY_API_KEY=your_relay_api_key_here
ENABLE_RELAY=false

# ARC Execution Layer Configuration
ARC_ADDRESS=0x... # ARC contract address on deployment
ARC_WEBHOOK_SECRET=your_webhook_secret_for_arc_callbacks

# Backend Logging
BACKEND_LOG_LEVEL=info
