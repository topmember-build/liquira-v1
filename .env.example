# Environment Configuration Template
# Copy this to .env and fill in your actual values

# Supabase Configuration (Optional - app works without it)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_URL=your_supabase_url
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database Configuration (Optional - for direct database access)
DATABASE_URL=your_database_url
DATABASE_HOST=your_database_host
DATABASE_PORT=5432
DATABASE_NAME=your_database_name
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password

# Circle Treasury Configuration (Optional - for stable FX quotes)
CIRCLE_API_KEY=your_circle_api_key
CIRCLE_WALLET_ID=your_circle_wallet_id
CIRCLE_ENTITY_SECRET=your_circle_entity_secret
CIRCLE_DESTINATION_ADDRESS=your_destination_address
CIRCLE_DESTINATION_BLOCKCHAIN=ARC
CIRCLE_STABLE_FX_ENABLED=true

# ARC Configuration (Optional - for webhook validation)
ARC_ADDRESS=your_arc_contract_address
ARC_WEBHOOK_SECRET=your_arc_webhook_secret

# Arc Testnet Configuration
# Arc wallet private key is used to sign and sponsor gas for payments.
ARC_DESTINATION_ADDRESS=your_arc_destination_address
ARC_PRIVATE_KEY=your_arc_private_key
VITE_ARC_TREASURY_ADDRESS=your_arc_treasury_address

# Dynamic Labs Configuration (Required for auth)
VITE_DYNAMIC_ENVIRONMENT_ID=your_dynamic_environment_id
DYNAMIC_ENVIRONMENT_ID=your_dynamic_environment_id
DYNAMIC_API_KEY=your_dynamic_api_key
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Provider API Keys (Optional - for quote aggregation)
LIFI_API_KEY=your_lifi_api_key
ENABLE_LIFI=true

SOCKET_API_KEY=your_socket_api_key
ENABLE_SOCKET=true

RELAY_API_KEY=your_relay_api_key
ENABLE_RELAY=true